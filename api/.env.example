# Copie para .env e preencha. O .env é gitignored — nunca versione valores reais.
SENSUS_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Prazo do token de sessao (7 dias). Vale para o token, nao so para o cookie.
SENSUS_SESSION_MAX_AGE_SECONDS=604800
# Cookie `Secure`. O default da aplicacao e `true`; o dev local em http://localhost
# nao tem TLS e o navegador descartaria o cookie.
SENSUS_SESSION_COOKIE_SECURE=false
SENSUS_UPSTREAM_BASE_URL=http://localhost:8000
SENSUS_UPSTREAM_API_KEY=
SENSUS_UPSTREAM_TIMEOUT_SECONDS=90
SENSUS_SUGGESTIONS=["Do que trata a base?","Como funciona o processo de X?","Quais sao os prazos?"]
SENSUS_CORS_ORIGINS=["http://localhost:5173"]
# Papel administrativo: migracao e administracao.
SENSUS_DATABASE_URL=
# Papel da aplicacao, SEM BYPASSRLS. Sem ele a RLS da migracao 003 e decoracao.
# A senha e passo de operacao (`alter role sensus_app password '...'`), nunca SQL versionado.
SENSUS_APP_DATABASE_URL=
SENSUS_VOYAGE_API_KEY=
SENSUS_EMBEDDING_MODEL=voyage-4-large
SENSUS_EMBEDDING_DIMENSIONS=1024
SENSUS_MAX_UPLOAD_BYTES=20971520
# Cota do provedor de embeddings. Vazio/0 = sem limite (chave com cota padrao).
# Conta gratuita da Voyage, sem metodo de pagamento, fica em 3 RPM e 10K TPM: preencha
# as duas abaixo e o cliente espaca as requisicoes em vez de levar 429 em serie.
SENSUS_EMBEDDING_REQUESTS_PER_MINUTE=0
SENSUS_EMBEDDING_TOKENS_PER_MINUTE=0
# Teto de tokens por requisicao. Tem de ser MENOR que a cota por minuto acima.
SENSUS_EMBEDDING_MAX_BATCH_TOKENS=8000

# --- Geracao -----------------------------------------------------------------
# Sem estas duas o chat responde em modo demonstracao (texto fixo).
SENSUS_OPENAI_API_KEY=
SENSUS_GENERATION_MODEL=gpt-4o-mini
SENSUS_GENERATION_TOP_K=5
SENSUS_GENERATION_MAX_CONTEXT_CHARS=12000
# Menor que SENSUS_UPSTREAM_TIMEOUT_SECONDS, para o estouro ser atribuivel.
SENSUS_GENERATION_TIMEOUT_SECONDS=60
# 0 = sem limite. O harness preenche; o chat nao precisa.
SENSUS_GENERATION_REQUESTS_PER_MINUTE=0
# Modelos que um tenant pode escolher no painel de config de IA (fatia 4a). E
# configuracao de OPERACAO: quem a muda somos nos, nao o cliente. SENSUS_GENERATION_MODEL
# (acima) e o default de quem nunca salvou config, entao mantenha-o NESTA lista -- fora
# dela, o painel abre sem opcao correspondente e salvar sem tocar no modelo da 422.
SENSUS_ALLOWED_GENERATION_MODELS=["gpt-4o-mini","gpt-4o"]

# --- E-mail (fatia 3d) -------------------------------------------------------
# SEM SENSUS_SMTP_HOST, o e-mail vai para o LOG do servidor, com link e tudo -- e e
# assim que se testa o reset numa maquina de desenvolvimento.
#
# COM ele, SENSUS_EMAIL_FROM e SENSUS_PUBLIC_BASE_URL viram obrigatorios e a aplicacao
# recusa subir sem eles: um link apontando para o host errado so apareceria na caixa de
# entrada de quem precisava dele.
SENSUS_SMTP_HOST=
SENSUS_SMTP_PORT=587
SENSUS_SMTP_USERNAME=
SENSUS_SMTP_PASSWORD=
SENSUS_SMTP_STARTTLS=true
SENSUS_EMAIL_FROM=
# De onde saem os links dos e-mails. Sem barra no fim.
SENSUS_PUBLIC_BASE_URL=http://localhost:5173
# Prazo do link de reset (1 hora). Bem menor que o do convite: quem pede reset esta na
# tela agora, e o link vale mais -- troca senha e abre sessao.
SENSUS_PASSWORD_RESET_MAX_AGE_SECONDS=3600
# Freio por conta: pedido novo dentro da janela nao gera e-mail, e a resposta continua
# sendo o mesmo 202.
SENSUS_PASSWORD_RESET_THROTTLE_SECONDS=120
